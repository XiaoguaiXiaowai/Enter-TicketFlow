{
  "name": "ticket-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:generate": "pnpm --filter @ticket/api db:generate",
    "build": "pnpm db:generate && pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm db:generate && pnpm --filter @ticket/shared build && tsc -p tsconfig.scripts.json && pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:env": "tsx scripts/check-env-example.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm check:env",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @ticket/api test:integration",
    "test:e2e": "playwright test",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
