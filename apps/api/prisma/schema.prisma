generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED

  @@map("tenant_status")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED

  @@map("membership_status")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  locale       String   @default("zh-CN")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  projects      Project[]
  memberships   Membership[]
  roles         Role[]
  fieldPolicies FieldPolicy[]
  sessions      Session[]

  @@map("tenants")
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membershipProjects  MembershipProject[]
  tickets             Ticket[]
  ticketCounters      TicketCounter[]
  kbArticles          KbArticle[]
  replyTemplates      ReplyTemplate[]

  @@unique([tenantId, code])
  @@map("projects")
}

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  projects MembershipProject[]
  roles    MembershipRole[]

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@map("memberships")
}

model MembershipProject {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([membershipId, projectId])
  @@index([tenantId, projectId])
  @@map("membership_projects")
}

model MembershipRole {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([tenantId, roleId])
  @@map("membership_roles")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  memberships  MembershipRole[]
  fieldPolicies FieldPolicy[]

  @@unique([tenantId, code])
  @@map("roles")
}

model RolePermission {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  resource  String
  action    String
  createdAt DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([tenantId, resource, action])
  @@map("role_permissions")
}

model FieldPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  resource  String
  field     String
  canRead   Boolean  @default(false) @map("can_read")
  canWrite  Boolean  @default(false) @map("can_write")
  masked    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, field])
  @@index([tenantId, resource])
  @@map("field_policies")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  tokenVersion     Int       @default(1) @map("token_version")
  userAgent        String?   @map("user_agent")
  ip               String?
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("ticket_priority")
}

enum TicketSource {
  WEB
  EMAIL
  PHONE
  API

  @@map("ticket_source")
}

enum MessageVisibility {
  PUBLIC
  INTERNAL

  @@map("message_visibility")
}

enum IdempotencyStatus {
  PENDING
  COMPLETED

  @@map("idempotency_status")
}

enum OutboxStatus {
  PENDING
  DELIVERED
  DEAD

  @@map("outbox_status")
}

model Ticket {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  projectId     String         @map("project_id") @db.Uuid
  ticketNo      String         @map("ticket_no")
  subject       String
  description   String
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(NORMAL)
  source        TicketSource   @default(WEB)
  customerName  String         @map("customer_name")
  customerPhone String?        @map("customer_phone")
  internalNote  String?        @map("internal_note")
  refundAmount  Decimal?       @map("refund_amount") @db.Decimal(12, 2)
  assigneeId    String?        @map("assignee_id") @db.Uuid
  tags          String[]       @default([])
  version       Int            @default(1)
  messageSeq    Int            @default(0) @map("message_seq")
  createdBy     String         @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  messages TicketMessage[]

  @@unique([tenantId, projectId, ticketNo])
  @@index([tenantId, projectId, status, updatedAt(sort: Desc)])
  @@index([tenantId, projectId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, assigneeId, status])
  @@map("tickets")
}

model TicketCounter {
  tenantId  String   @map("tenant_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@id([tenantId, projectId])
  @@map("ticket_counters")
}

model TicketMessage {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  ticketId   String            @map("ticket_id") @db.Uuid
  seq        Int
  visibility MessageVisibility
  body       String
  authorId   String            @map("author_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, seq])
  @@index([ticketId, seq])
  @@map("ticket_messages")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  projectId     String?  @map("project_id") @db.Uuid
  resource      String
  resourceId    String   @map("resource_id") @db.Uuid
  action        String
  actorId       String   @map("actor_id") @db.Uuid
  requestId     String   @map("request_id")
  ip            String?
  before        Json?
  after         Json?
  changedFields String[] @default([]) @map("changed_fields")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, resource, resourceId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model IdempotencyKey {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  key              String
  endpoint         String
  requestHash      String            @map("request_hash")
  status           IdempotencyStatus @default(PENDING)
  statusCode       Int?              @map("status_code")
  responseSnapshot Json?             @map("response_snapshot")
  expiresAt        DateTime          @map("expires_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at")
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}

enum KbArticleVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("kb_article_version_status")
}

model KbArticle {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  slug               String
  publishedVersionId String?   @map("published_version_id") @db.Uuid
  version            Int       @default(1)
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versions KbArticleVersion[]

  @@unique([projectId, slug])
  @@index([tenantId, projectId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, publishedVersionId])
  @@map("kb_articles")
}

model KbArticleVersion {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  articleId   String               @map("article_id") @db.Uuid
  versionNo   Int                  @map("version_no")
  title       String
  body        String
  status      KbArticleVersionStatus @default(DRAFT)
  authorId    String               @map("author_id") @db.Uuid
  publishedAt DateTime?            @map("published_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  article KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, versionNo])
  @@index([tenantId, articleId, versionNo(sort: Desc)])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "kb_article_versions_title_trgm_idx")
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "kb_article_versions_body_trgm_idx")
  @@map("kb_article_versions")
}

model ReplyTemplate {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  name       String
  body       String
  variables  Json
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, name])
  @@index([tenantId, projectId, updatedAt(sort: Desc)])
  @@map("reply_templates")
}
