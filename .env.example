# 运行环境
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info

# PostgreSQL：数据库名、超级用户（仅用于容器初始化与建角色）
POSTGRES_DB=ticket
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local_dev_superuser

# 三个数据库角色的连接串，主机名对应 compose 服务名
DATABASE_URL=postgresql://app_rw:local_dev_rw@postgres:5432/ticket?schema=public
MIGRATE_DATABASE_URL=postgresql://app_migrator:local_dev_migrator@postgres:5432/ticket?schema=public
WORKER_DATABASE_URL=postgresql://app_worker:local_dev_worker@postgres:5432/ticket?schema=public

# Redis：会话索引、限流与缓存
REDIS_URL=redis://redis:6379
