# 运行环境
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info

# PostgreSQL：数据库名、超级用户（仅用于容器初始化与建角色）
POSTGRES_DB=ticket
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local_dev_superuser

# 三个数据库角色的连接串，主机名对应 compose 服务名
DATABASE_URL=postgresql://app_rw:local_dev_rw@postgres:5432/ticket?schema=public
MIGRATE_DATABASE_URL=postgresql://app_migrator:local_dev_migrator@postgres:5432/ticket?schema=public
WORKER_DATABASE_URL=postgresql://app_worker:local_dev_worker@postgres:5432/ticket?schema=public

# Redis：限流计数与缓存；不可用时自动降级为进程内计数
REDIS_URL=redis://redis:6379
REDIS_COMMAND_TIMEOUT_MS=1000

# 限流：读写按租户+用户分桶；登录失败按 IP+账号锁定
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=300
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_LOCK_SECONDS=600

# Outbox Worker：轮询、批大小、租约与重试上限
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LEASE_SECONDS=30
# 留空表示只记录日志，不投递到下游
OUTBOX_WEBHOOK_URL=

# 指标与告警阈值
METRICS_INTERVAL_SECONDS=30
ALERT_5XX_RATIO_PERCENT=1
ALERT_OUTBOX_BACKLOG_THRESHOLD=100
ALERT_LOGIN_FAILURE_PER_MINUTE=20

# 备份与恢复演练（tools profile）
BACKUP_ENCRYPTION_PASSPHRASE=local_dev_backup_passphrase_change_me
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=/backups

# 性能验证脚本
PERF_BASE_URL=http://localhost/api
PERF_ITERATIONS=50

# 认证：本地与预发使用对称密钥，生产由部署平台以密钥文件注入
JWT_SECRET=local_dev_jwt_secret_change_me_0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Argon2id 参数
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# 演示租户种子密码（仅 seed 使用）
SEED_DEFAULT_PASSWORD=local_dev_seed_password
